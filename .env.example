# fixtures | neto
DATA_SOURCE=fixtures
# local (storefront-held bag, hands off at checkout) | neto (same-origin /ajax/addtocart; needs same-domain routing)
NEXT_PUBLIC_CART_MODE=local
# Where Neto-owned pages live. Leave empty on the same-domain setup; set to the live store while standalone.
NEXT_PUBLIC_COMMERCE_ORIGIN=https://www.ozled.com.au
NEXT_PUBLIC_SITE_URL=https://www.ozled.com.au

NETO_API_URL=https://www.ozled.com.au/do/WS/NetoAPI
NETO_API_USERNAME=
NETO_API_KEY=
NETO_WEBHOOK_SECRET=
NETO_PICKUP_WAREHOUSE_ID=

NEXT_PUBLIC_GA4_ID=
ALLOW_INDEXING=
